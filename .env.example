# PlainMarket environment variables
#
# The MVP runs entirely on mock data, so NONE of these are required yet.
# When an integration is added, copy this file to `.env.local` and fill it in.

# --- Site URL ---
# Absolute origin for metadata, sitemap and robots.txt. Optional: on Vercel it
# falls back to the deployment URL automatically. Set this to a custom domain.
# NEXT_PUBLIC_SITE_URL=https://plainmarket.app

# --- Supabase (database) ---
# The tables exist (supabase/schema.sql + supabase/seed.sql), but the app does
# not read from them yet. These become required in a later step.
#   Project URL and anon key: Supabase dashboard -> Project Settings -> API.
#   The anon key is safe to expose; the tables are read-only to the public.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Market & news data providers (planned) ---
# MARKET_DATA_API_KEY=
# NEWS_API_KEY=
