# PlainMarket environment variables
#
# The MVP runs entirely on mock data, so NONE of these are required yet.
# When an integration is added, copy this file to `.env.local` and fill it in.

# --- Supabase / Postgres (planned) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Market & news data providers (planned) ---
# MARKET_DATA_API_KEY=
# NEWS_API_KEY=
